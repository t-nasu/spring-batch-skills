<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.pointbatch.infrastructure.datasource.mybatis.mapper.PointExpirationHistoryMapper">

    <!-- 1 チャンク分をまとめて登録する。 -->
    <insert id="insertAll">
        INSERT INTO point_expiration_history (
            member_point_id,
            member_id,
            amount,
            expired_on,
            created_at
        ) VALUES
        <foreach collection="records" item="record" separator=",">
            (
                #{record.memberPointId},
                #{record.memberId},
                #{record.amount},
                #{record.expiredOn},
                CURRENT_TIMESTAMP
            )
        </foreach>
    </insert>

</mapper>
